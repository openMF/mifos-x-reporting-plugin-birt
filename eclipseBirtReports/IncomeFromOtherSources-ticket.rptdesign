            <xml-property name="queryText"><![CDATA[SELECT
    c.display_name AS client_name,
    c.account_no AS account_no,
    off.name AS office_name,

    je.transaction_id AS transaction_id,
    je.transaction_date AS transaction_date,
    je.amount AS amount,
    je.currency_code AS currency,
    je.ref_num AS external_ref,
    acc.name AS gl_account_name,
    
    pt.description AS payment_method,
    t.name AS teller_name,
    CAST(t.id AS VARCHAR(20)) AS teller_no

FROM acc_gl_journal_entry je
JOIN acc_gl_account acc ON acc.id = je.account_id
JOIN m_office off ON off.id = je.office_id
LEFT JOIN m_client_transaction ct ON ct.id = je.client_transaction_id
LEFT JOIN m_client c ON c.id = ct.client_id
LEFT JOIN m_payment_detail pd ON pd.id = je.payment_details_id
LEFT JOIN m_payment_type pt ON pt.id = pd.payment_type_id

LEFT JOIN m_appuser au ON au.id = je.created_by
LEFT JOIN m_staff s ON s.id = au.staff_id
LEFT JOIN m_cashiers cash ON cash.staff_id = s.id
LEFT JOIN m_tellers t ON t.id = cash.teller_id

WHERE je.transaction_id = ? 
  AND je.reversed = false 
  AND je.type_enum = 2 
  AND off.hierarchy LIKE CONCAT(?, '%')
  ]]></xml-property>
